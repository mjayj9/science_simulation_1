# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo
/.sites-package/

# Local agent/editor tooling state
/.claude/

# Resumable audit checkpoints, including the per-run files parallel partial runs
# write. Intermediate compute state keyed to a source fingerprint, not published
# evidence: the audits discard them whenever that fingerprint changes and publish
# their results as docs/ artifacts instead.
docs/.*-checkpoint*.json

# Half-written files from an interrupted atomic publish.
*.tmp
