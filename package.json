{
  "name": "solarform-engineering-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25.0.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:cloudflare": "node scripts/build-target.mjs cloudflare",
    "start": "vinext start",
    "start:standalone": "node dist/standalone/server.js",
    "test": "npm run test:unit && npm run build && npm run test:smoke",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:smoke": "node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:research": "node --experimental-strip-types scripts/audit-research-benchmarks.ts docs/research-source-equivalent-audit.json docs/research-source-equivalent-audit.md",
    "audit:thermal": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-annual-transient.ts",
    "audit:engineering-mesh": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-engineering-mesh-convergence.ts",
    "audit:transient-engineering": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-transient-engineering-full-year.ts",
    "audit:natural": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-natural-rotation.ts",
    "audit:annual": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-full-year-comparison-v2.ts",
    "audit:geometry": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-fair-geometry.ts",
    "audit:thermal-compare": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/audit-thermal-model-comparison.ts",
    "audit:manifest": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/write-validation-manifest.ts docs/validation-audit-manifest-2026.json",
    "audit:all": "npm run audit:engineering-mesh && npm run audit:research && npm run audit:geometry && npm run audit:natural && npm run audit:thermal && npm run audit:thermal-compare && npm run audit:annual && npm run audit:transient-engineering && npm run audit:manifest && npm run report:validation",
    "report:validation": "node --experimental-strip-types scripts/run-vite-audit.ts /scripts/generate-validation-report-v2.ts docs/generated-validation-report-2026.md",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "@xyflow/react": "^12.12.0",
    "drizzle-orm": "0.45.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vinext": "1.0.0-beta.2",
    "vite": "8.3.1",
    "vitest": "^4.1.10",
    "wrangler": "4.139.0"
  },
  "type": "module"
}
